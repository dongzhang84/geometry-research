LIB "matrix.lib";
ring r=0,(d0,d1,d2,d3,t0,t1,t2,t3),dp;
poly E01=(t0+t1)^2; poly E23=(t2+t3)^2; poly E02=(t0+t2)^2; poly E13=(t1+t3)^2; poly E03=(t0+t3)^2; poly E12=(t1+t2)^2;
ideal I=d2*d3*(d0^2+d1^2-E01)-d0*d1*(d2^2+d3^2-E23),
        d1*d3*(d0^2+d2^2-E02)-d0*d2*(d1^2+d3^2-E13),
        d1*d2*(d0^2+d3^2-E03)-d0*d3*(d1^2+d2^2-E12),
        d2*d3*(d0^2+d1^2-E01)+d1*d3*(d0^2+d2^2-E02)+d1*d2*(d0^2+d3^2-E03)+2*d0*d1*d2*d3;
int tm=rtimer; system("--ticks-per-sec",1000);
matrix P[4][3]=1,d0,d0^2-t0^2,1,d1,d1^2-t1^2,1,d2,d2^2-t2^2,1,d3,d3^2-t3^2;
poly A=t1*t2*t3*d0+t0*t2*t3*d1+t0*t1*t3*d2+t0*t1*t2*d3;
poly D=d0*d1*d2*d3;
ideal H;
H[1]=det(submat(P,intvec(1,2,3),intvec(1,2,3)));
H[2]=det(submat(P,intvec(1,2,4),intvec(1,2,3)));
H[3]=det(submat(P,intvec(1,3,4),intvec(1,2,3)));
H[4]=det(submat(P,intvec(2,3,4),intvec(1,2,3)));
ideal J=std(I);
"gb ms:"; rtimer-tm;
int k; for(k=1;k<=4;k++){ "minor",k,": A*D*h in I =",reduce(A*D*H[k],J)==0, "  D*h in I =",reduce(D*H[k],J)==0, "  A*h in I =",reduce(A*H[k],J)==0; }
ideal G=A*D*H[1]; matrix L=lift(I,G);
write(":w c1_cert.txt", string(L[1,1])+";"+string(L[2,1])+";"+string(L[3,1])+";"+string(L[4,1]));
"total ms:"; rtimer-tm;
quit;
