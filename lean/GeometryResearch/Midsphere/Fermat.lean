/-! ## 由子式为零得到仿射关系 -/

/-- 行 (1, dᵢ, Fᵢ)、(1, dⱼ, Fⱼ)、(1, d_k, F_k) 的行列式。 -/
def minor3 (d F : Fin 4 → ℝ) (i j k : Fin 4) : ℝ :=
  d j * F k - d k * F j - d i * F k + d k * F i + d i * F j - d j * F i

theorem interp {d F : Fin 4 → ℝ} {i j : Fin 4} (hij : d i ≠ d j) (k : Fin 4)
    (hm : minor3 d F i j k = 0) :
    F k = (F i - (F j - F i) / (d j - d i) * d i) + (F j - F i) / (d j - d i) * d k := by
  have h : d j - d i ≠ 0 := sub_ne_zero.mpr (Ne.symm hij)
  simp only [minor3] at hm
  field_simp
  linear_combination hm

set_option linter.flexible false in
theorem affine_of_minors {d F : Fin 4 → ℝ} (m1 : minor3 d F 0 1 2 = 0)
    (m2 : minor3 d F 0 1 3 = 0) (m3 : minor3 d F 0 2 3 = 0) (hne : ¬ ∀ i, d i = d 0) :
    ∃ α β : ℝ, ∀ k, F k = α + β * d k := by
  simp only [minor3] at m1 m2 m3
  by_cases h01 : d 0 = d 1
  · by_cases h02 : d 0 = d 2
    · have h03 : d 0 ≠ d 3 := by
        intro h3; apply hne; intro i; fin_cases i
        · rfl
        · exact h01.symm
        · exact h02.symm
        · exact h3.symm
      refine ⟨_, _, fun k => interp h03 k ?_⟩
      simp only [minor3]
      fin_cases k <;> simp <;> (try ring_nf) <;> (try ring_nf at m1 m2 m3) <;>
        first | exact m1 | exact m2 | exact m3 | linarith
    · refine ⟨_, _, fun k => interp h02 k ?_⟩
      simp only [minor3]
      fin_cases k <;> simp <;> (try ring_nf) <;> (try ring_nf at m1 m2 m3) <;>
        first | exact m1 | exact m2 | exact m3 | linarith
  · refine ⟨_, _, fun k => interp h01 k ?_⟩
    simp only [minor3]
    fin_cases k <;> simp <;> (try ring_nf) <;> (try ring_nf at m1 m2 m3) <;>
        first | exact m1 | exact m2 | exact m3 | linarith

/-! ## F* 方向的恒等式 -/

/-- Gram 矩阵。 -/
def gam (a b : ℝ) (i j : Fin 4) : ℝ :=
  if i = j then 1 else
  if (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0) ∨ (i = 2 ∧ j = 3) ∨ (i = 3 ∧ j = 2) then a else
  if (i = 0 ∧ j = 2) ∨ (i = 2 ∧ j = 0) ∨ (i = 1 ∧ j = 3) ∨ (i = 3 ∧ j = 1) then b else
  -1 - a - b

/-- |VₖVₗ|² 用 d 与 γ 表示。 -/
def D2f (d : Fin 4 → ℝ) (a b : ℝ) (k l : Fin 4) : ℝ :=
  d k ^ 2 + d l ^ 2 - 2 * gam a b k l * d k * d l

/-- 面 j 的面积平方，按 `S2_dists` 的顶点顺序。 -/
def Sf (d : Fin 4 → ℝ) (a b : ℝ) (j : Fin 4) : ℝ :=
  (D2f d a b (j.succAbove 0) (j.succAbove 1) * D2f d a b (j.succAbove 0) (j.succAbove 2) -
    ((D2f d a b (j.succAbove 0) (j.succAbove 1) + D2f d a b (j.succAbove 0) (j.succAbove 2) -
      D2f d a b (j.succAbove 1) (j.succAbove 2)) / 2) ^ 2) / 4

/-- τ² = det(γ 的 3×3 主子式)。 -/
def tau2 (a b : ℝ) : ℝ := 1 + 2 * a * b * (-1 - a - b) - a ^ 2 - b ^ 2 - (-1 - a - b) ^ 2

set_option maxHeartbeats 4000000 in -- 多项式恒等式
/-- F* 方向的恒等式：Σⱼ γⱼᵢ Sⱼ² dⱼ² = −½τ²Π²w(1/dᵢ − w/4)。 -/
theorem fstar_id (d : Fin 4 → ℝ) (hd : ∀ j, d j ≠ 0) (a b : ℝ) (i : Fin 4) :
    ∑ j, gam a b j i * Sf d a b j * d j ^ 2 =
      -(1 / 2) * tau2 a b * (d 0 * d 1 * d 2 * d 3) ^ 2 * (∑ j, 1 / d j) *
        (1 / d i - (∑ j, 1 / d j) / 4) := by
  have h0 := hd 0; have h1 := hd 1; have h2 := hd 2; have h3 := hd 3
  fin_cases i <;> simp [Fin.sum_univ_four, gam, Sf, D2f, tau2, Fin.succAbove] <;> field_simp <;> ring

/-! ## 几何部分 -/

/-- 与 w₁、w₂、w₃ 都正交的向量为零。 -/
theorem zero_of_perp {x : E3} (h : ∀ k : Fin 3, ⟪x, w t k.succ⟫ = 0) : x = 0 := by
  have hspan := (linIndep_w (t := t)).span_eq_top_of_card_eq_finrank (by simp)
  have hle : Submodule.span ℝ (Set.range fun k : Fin 3 => w t k.succ) ≤ (ℝ ∙ x)ᗮ := by
    rw [Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    exact (Submodule.mem_orthogonal_singleton_iff_inner_right).mpr (h k)
  rw [hspan] at hle
  have hx : x ∈ (ℝ ∙ x)ᗮ := hle Submodule.mem_top
  rw [Submodule.mem_orthogonal_singleton_iff_inner_right] at hx
  exact inner_self_eq_zero.mp hx

/-- ofWeights x − P = (1/Σx)·Σ xⱼ(Vⱼ − P)。 -/
theorem ofW_sub_pt (x : Fin 4 → ℝ) (hx : ∑ j, x j ≠ 0) (P : E3) :
    ofWeights t x - P = (1 / ∑ j, x j) • ∑ j, x j • (t.points j - P) := by
  have e := ofW_sub_V0 t x hx
  have : ∑ j, x j • (t.points j - P) = L t x - (∑ j, x j) • (P - t.points 0) := by
    simp only [L, w, Finset.sum_smul, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl (fun j _ => by rw [← smul_sub]; congr 1; abel)
  rw [this, smul_sub, smul_smul, one_div_mul_cancel hx, one_smul, ← e]
  abel

theorem gam_diag (a b : ℝ) (i : Fin 4) : gam a b i i = 1 := by simp [gam]

theorem gam_symm (a b : ℝ) (i j : Fin 4) : gam a b j i = gam a b i j := by
  fin_cases i <;> fin_cases j <;> simp [gam]

theorem collinear_of_dir {F Fs Mp : E3} (lam : ℝ) (h : Mp - F = lam • (Fs - F)) :
    Collinear ℝ ({F, Fs, Mp} : Set E3) := by
  rw [collinear_iff_of_mem (Set.mem_insert F _)]
  refine ⟨Fs - F, fun p hp => ?_⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
  rcases hp with rfl | rfl | rfl
  · exact ⟨0, by simp⟩
  · exact ⟨1, by simp⟩
  · exact ⟨lam, by rw [vadd_eq_add, ← h]; abel⟩

theorem collinear_of_eq {F Fs Mp : E3} (h : Fs = F) : Collinear ℝ ({F, Fs, Mp} : Set E3) := by
  rw [h, Set.insert_eq_of_mem (Set.mem_insert F _)]
  exact collinear_pair ℝ F Mp

set_option maxHeartbeats 4000000 in -- 组装
/-- 定理 11 的证明。 -/
theorem fermat_main (hfb : IsFourBall t r) {F : E3} (hF : GeometryResearch.Orthocentric.IsFermatPoint t F)
    (hFv : ∀ j, F ≠ t.points j) :
    Collinear ℝ ({F, GeometryResearch.Orthocentric.isogonal t F, M t r} : Set E3) := by
  have hr := hfb.1
  set d : Fin 4 → ℝ := fun j => dist F (t.points j) with hd_def
  have hd : ∀ j, 0 < d j := fun j => dist_pos.mpr (hFv j)
  have hd0 : ∀ j, d j ≠ 0 := fun j => (hd j).ne'
  set u : Fin 4 → E3 := fun j => (1 / d j) • (t.points j - F) with hu_def
  have hVu : ∀ j, t.points j - F = d j • u j := by
    intro j; simp only [u, smul_smul, mul_one_div_cancel (hd0 j), one_smul]
  have hn : ∀ j, ‖t.points j - F‖ = d j := fun j => by
    simp only [d]; rw [dist_comm, dist_eq_norm]
  have hu1 : ∀ j, ⟪u j, u j⟫ = 1 := by
    intro j
    rw [real_inner_self_eq_norm_sq, norm_smul, mul_pow, hn j, Real.norm_eq_abs, sq_abs]
    field_simp [hd0 j]
  have hsum : ∑ j, u j = 0 := GeometryResearch.Orthocentric.fermat_grad t hF hFv
  clear_value u
  have hrow : ∀ i, ∑ j, ⟪u i, u j⟫ = 0 := by
    intro i; rw [← inner_sum, hsum, inner_zero_right]
  -- Gram 矩阵的结构
  set a := ⟪u 0, u 1⟫ with ha
  set b := ⟪u 0, u 2⟫ with hb
  have hG : ∀ i j, ⟪u i, u j⟫ = gam a b i j := by
    have r0 := hrow 0; have r1 := hrow 1; have r2 := hrow 2; have r3 := hrow 3
    simp only [Fin.sum_univ_four, hu1] at r0 r1 r2 r3
    have c := fun i j => real_inner_comm (u i) (u j)
    have c10 := c 0 1; have c20 := c 0 2; have c30 := c 0 3; have c21 := c 1 2
    have c31 := c 1 3; have c32 := c 2 3
    intro i j
    by_cases hij : i = j
    · subst hij; rw [hu1, gam_diag]
    fin_cases i <;> fin_cases j <;> simp [gam] at hij ⊢ <;> linarith
  have hD : ∀ i j, dist (t.points i) (t.points j) ^ 2 = D2f d a b i j := by
    intro i j
    rw [dist_eq_norm, show t.points i - t.points j = (t.points i - F) - (t.points j - F) by abel,
      hVu, hVu, ← real_inner_self_eq_norm_sq]
    simp only [inner_sub_left, inner_sub_right, real_inner_smul_left, real_inner_smul_right, hG,
      D2f, gam_diag, gam_symm a b i j]
    ring
  have hE : ∀ i j, i ≠ j → (r i + r j) ^ 2 - d i ^ 2 - d j ^ 2 + 2 * gam a b i j * d i * d j = 0 := by
    intro i j hij
    have := hD i j
    rw [hfb.2 i j hij, D2f] at this
    linarith
  -- 子式
  have hA : d 0 * r 1 * r 2 * r 3 + d 1 * r 0 * r 2 * r 3 + d 2 * r 0 * r 1 * r 3 +
      d 3 * r 0 * r 1 * r 2 ≠ 0 := by
    have := hd 0; have := hd 1; have := hd 2; have := hd 3
    have := hr 0; have := hr 1; have := hr 2; have := hr 3; positivity
  have e01 := hE 0 1 (by decide); have e23 := hE 2 3 (by decide); have e02 := hE 0 2 (by decide)
  have e13 := hE 1 3 (by decide); have e03 := hE 0 3 (by decide); have e12 := hE 1 2 (by decide)
  simp only [gam] at e01 e23 e02 e13 e03 e12
  norm_num at e01 e23 e02 e13 e03 e12
  have m1 : minor3 d (fun k => d k ^ 2 - r k ^ 2) 0 1 2 = 0 := by
    simp only [minor3]
    exact fminor1 (a := a) (b := b) (by linear_combination e01) (by linear_combination e23)
      (by linear_combination e02) (by linear_combination e13) (by linear_combination e03)
      (by linear_combination e12) hA
  have m2 : minor3 d (fun k => d k ^ 2 - r k ^ 2) 0 1 3 = 0 := by
    simp only [minor3]
    exact fminor2 (a := a) (b := b) (by linear_combination e01) (by linear_combination e23)
      (by linear_combination e02) (by linear_combination e13) (by linear_combination e03)
      (by linear_combination e12) hA
  have m3 : minor3 d (fun k => d k ^ 2 - r k ^ 2) 0 2 3 = 0 := by
    simp only [minor3]
    exact fminor3 (a := a) (b := b) (by linear_combination e01) (by linear_combination e23)
      (by linear_combination e02) (by linear_combination e13) (by linear_combination e03)
      (by linear_combination e12) hA
  -- F 的重心坐标为 (1/dⱼ)
  set ws := ∑ j, 1 / d j with hws
  have hwp : 0 < ws := Finset.sum_pos (fun j _ => one_div_pos.mpr (hd j)) Finset.univ_nonempty
  have hFw : F = ofWeights t (fun j => 1 / d j) := by
    have e := ofW_sub_pt (t := t) (fun j => 1 / d j) hwp.ne' F
    have h0 : ∑ j, (1 / d j) • (t.points j - F) = 0 := by
      rw [← hsum]
      exact Finset.sum_congr rfl (fun j _ => by
        rw [hVu, smul_smul, one_div_mul_cancel (hd0 j), one_smul])
    rw [h0, smul_zero, sub_eq_zero] at e
    exact e.symm
  have hbary : ∀ j, GeometryResearch.Orthocentric.bary t F j = 1 / d j / ws := by
    intro j
    have := GeometryResearch.Orthocentric.bary_ofWeights' t (fun j => 1 / d j) hwp.ne' j
    rw [← hFw] at this
    exact this
  -- 面积用 d、γ 表示
  have hS2 : ∀ j, GeometryResearch.Orthocentric.S2 t j = Sf d a b j := by
    intro j
    have := S2_dists (t := t) j
    simp only [Affine.Simplex.faceOpposite_point_eq_point_succAbove] at this
    rw [this, hD, hD, hD]
    rfl
  have hSpos : ∀ j, 0 < GeometryResearch.Orthocentric.S2 t j := by
    intro j
    rw [heron hfb]
    have := hr j
    have hP : 0 < ∏ k, r k := Finset.prod_pos (fun k _ => hr k)
    have hs : 0 < ∑ k, r k - r j := by
      rw [Fin.sum_univ_four]; have := hr 0; have := hr 1; have := hr 2; have := hr 3
      fin_cases j <;> simp <;> linarith
    positivity
  set Fs := GeometryResearch.Orthocentric.isogonal t F with hFs_def
  have hFs : Fs = ofWeights t (fun j => GeometryResearch.Orthocentric.S2 t j * d j) := by
    simp only [Fs, GeometryResearch.Orthocentric.isogonal, hbary]
    rw [← ofW_smul t ws hwp.ne' (fun j => GeometryResearch.Orthocentric.S2 t j * d j)]
    congr 1; funext j; field_simp [hd0 j]
  set β := ∑ j, GeometryResearch.Orthocentric.S2 t j * d j with hβ_def
  have hβ : 0 < β := Finset.sum_pos (fun j _ => mul_pos (hSpos j) (hd j)) Finset.univ_nonempty
  set κ := 1 / β * (-(1 / 2) * tau2 a b * (d 0 * d 1 * d 2 * d 3) ^ 2 * ws) with hκ_def
  have hvF : ∀ i, ⟪Fs - F, u i⟫ = κ * (1 / d i - ws / 4) := by
    intro i
    rw [hFs, ofW_sub_pt _ hβ.ne' F, real_inner_smul_left, sum_inner]
    have e : ∑ j, ⟪(GeometryResearch.Orthocentric.S2 t j * d j) • (t.points j - F), u i⟫ =
        ∑ j, gam a b j i * Sf d a b j * d j ^ 2 := by
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hVu, real_inner_smul_left, real_inner_smul_left, hG, hS2]; ring
    rw [e, fstar_id d hd0 a b i, hκ_def, ← hws, ← hβ_def]
    ring
  -- M 的 v 值
  have hvM : ∀ i, ⟪M t r - F, u i⟫ =
      (‖M t r - F‖ ^ 2 - ρ t r ^ 2 + (d i ^ 2 - r i ^ 2)) / (2 * d i) := by
    intro i
    have hp : ⟪M t r - F, t.points i - F⟫ =
        (‖M t r - F‖ ^ 2 + ‖t.points i - F‖ ^ 2 - ‖M t r - t.points i‖ ^ 2) / 2 := by
      rw [show M t r - t.points i = (M t r - F) - (t.points i - F) by abel]
      generalize M t r - F = p; generalize t.points i - F = q
      rw [norm_sub_sq_real]; ring
    have hv := vert_pow hfb i
    rw [dist_eq_norm, ← norm_neg, neg_sub] at hv
    rw [hn, hv, hVu, real_inner_smul_right] at hp
    field_simp [hd0 i]
    linear_combination 2 * hp
  -- v 是单射
  have inj : ∀ Y, (∀ i, ⟪Y - F, u i⟫ = 0) → Y = F := by
    intro Y hY
    have h1 : ∀ i, ⟪Y - F, t.points i - F⟫ = 0 := fun i => by
      rw [hVu, real_inner_smul_right, hY, mul_zero]
    refine sub_eq_zero.mp (zero_of_perp (t := t) fun k => ?_)
    rw [show w t k.succ = (t.points k.succ - F) - (t.points 0 - F) by simp only [w]; abel,
      inner_sub_right, h1, h1, sub_zero]
  by_cases hall : ∀ i, d i = d 0
  · refine collinear_of_eq (inj Fs fun i => ?_)
    rw [hvF]
    have : ws = 4 / d 0 := by rw [hws, Fin.sum_univ_four, hall 1, hall 2, hall 3]; ring
    rw [this, hall i]
    field_simp [hd0 0]
    ring
  · obtain ⟨α, β', hab⟩ := affine_of_minors m1 m2 m3 hall
    set K := ‖M t r - F‖ ^ 2 - ρ t r ^ 2
    have hsv : ∑ i, ⟪M t r - F, u i⟫ = 0 := by rw [← inner_sum, hsum, inner_zero_right]
    simp only [hvM, hab, Fin.sum_univ_four] at hsv
    have hsv' : (K + α) * ws / 2 + 2 * β' = 0 := by
      rw [hws, Fin.sum_univ_four]
      field_simp [hd0 0, hd0 1, hd0 2, hd0 3] at hsv ⊢
      linear_combination hsv
    have hvM' : ∀ i, ⟪M t r - F, u i⟫ = (K + α) / 2 * (1 / d i - ws / 4) := by
      intro i
      rw [hvM, hab]
      field_simp [hd0 i]
      linear_combination (2 * d i) * hsv'
    by_cases hκ : κ = 0
    · exact collinear_of_eq (inj Fs fun i => by rw [hvF, hκ, zero_mul])
    · refine collinear_of_dir ((K + α) / 2 / κ) ?_
      have := inj (M t r - ((K + α) / 2 / κ) • (Fs - F)) fun i => by
        rw [show M t r - ((K + α) / 2 / κ) • (Fs - F) - F =
          (M t r - F) - ((K + α) / 2 / κ) • (Fs - F) by abel, inner_sub_left,
          real_inner_smul_left, hvM', hvF]
        field_simp
        ring
      calc M t r - F = (M t r - ((K + α) / 2 / κ) • (Fs - F)) - F +
            ((K + α) / 2 / κ) • (Fs - F) := by abel
        _ = ((K + α) / 2 / κ) • (Fs - F) := by rw [this, sub_self, zero_add]

end GeometryResearch.Midsphere



